# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is never committed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Database (Neon) -------------------------------------------------------
# TWO urls, on purpose — see docs/BACKEND-DESIGN.md §5.8
#   DATABASE_URL -> the POOLED endpoint (host contains "-pooler"). Used by the app.
#   DIRECT_URL   -> the DIRECT endpoint (no "-pooler"). Used by migrations only.
# Neon dashboard > your project > Connection string. Toggle "Connection pooling".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Seeding ---------------------------------------------------------------
# The admin password. Leave blank in development and the seed generates a random
# one and prints it once. REQUIRED when seeding with NODE_ENV=production.
SEED_ADMIN_PASSWORD=

# The e2e suites sign in as `admin` to approve the companies they create.
# Put whatever the seed printed (or whatever you set above) here. Quote it if
# it contains a '#': node --env-file truncates the value there otherwise.
ADMIN_PASSWORD=

# --- Proxy & docs ----------------------------------------------------------
# TRUST_PROXY: set true ONLY when a proxy (Fly, Render, nginx) sits in front.
# Trusting X-Forwarded-For without one lets clients forge it and bypass rate
# limiting on /auth/login.
TRUST_PROXY=false
# ENABLE_DOCS: /docs is on in development and off in production unless set.
ENABLE_DOCS=false

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist. MUST be set in production: the API refuses to boot
# with an empty list rather than reflecting any origin back.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# --- Product images --------------------------------------------------------
# Phase 0 serves the repo's own assets/ over HTTP. Swap for the R2 CDN base
# url at deploy time; nothing else changes.
PUBLIC_ASSET_BASE_URL=http://localhost:3100/static

# --- Cloudflare R2 (phase 1: KYC documents) --------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_DOCUMENTS=naftal-documents
