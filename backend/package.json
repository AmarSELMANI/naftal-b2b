{
  "name": "naftal-b2b-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Naftal B2B ordering API — tires & lubricants, credit accounts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "node prisma/seed.js",
    "studio": "prisma studio",
    "reset": "prisma migrate reset --force",
    "test:e2e": "node --env-file=.env tests/onboarding.e2e.mjs && node --env-file=.env tests/orders.e2e.mjs && node --env-file=.env tests/notifications.e2e.mjs",
    "test:race": "node tests/credit-race.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.3.1"
  },
  "overrides": {
    "@fastify/static": "^10.1.5"
  }
}
